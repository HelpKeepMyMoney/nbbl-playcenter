# --- Local emulator development ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-playcenter.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-playcenter
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-playcenter.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:demo
NEXT_PUBLIC_USE_EMULATORS=true

